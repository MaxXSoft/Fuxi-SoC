# SD-only maintenance environment. SPL uses upstream ZedBoard PS initialization.
CONFIG_DEFAULT_DEVICE_TREE="zynq-zed"
CONFIG_OF_LIST="zynq-zed"
CONFIG_BOOTDELAY=-1
# CONFIG_USE_PREBOOT is not set
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="echo Use the documented manual QSPI update command"
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_FAT is not set
# CONFIG_ENV_IS_IN_NAND is not set
# CONFIG_ENV_IS_IN_SPI_FLASH is not set
# CONFIG_ENV_REDUNDANT is not set
# CONFIG_CMD_SAVEENV is not set
# CONFIG_CMD_ERASEENV is not set
# CONFIG_SPL_FPGA is not set
CONFIG_CMD_FAT=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_CMD_MMC=y
CONFIG_CMD_SF=y
CONFIG_CMD_MEMORY=y
CONFIG_CMD_ITEST=y
CONFIG_CMD_SOURCE=y
CONFIG_CMD_HASH=y
CONFIG_HASH_VERIFY=y
CONFIG_SHA256=y
CONFIG_LEGACY_IMAGE_FORMAT=y
# CONFIG_TOOLS_MKEFICAPSULE is not set
# CONFIG_PYLIBFDT is not set
